# Copy to .env for local development (restart `npm run dev` after changes).
# In production, set it in Vercel → Project → Settings → Environment Variables,
# then redeploy (Vite inlines it at build time).
#
# /r redirects here when set. Accepts https://... or a same-site path (/docs/...).
# Leave empty to show the links page (GitHub, LinkedIn, Resume, WhatsApp).
VITE_REDIRECT_URL=
